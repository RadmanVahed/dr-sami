# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=https://raminsami.ir

# Persistent data directory (use /data in Coolify with a mounted volume)
NUXT_DATA_DIR=.data/app

# Session encryption password (min 32 characters, change in production)
NUXT_SESSION_PASSWORD=change-me-in-production-use-random-32-chars
